{
  "name": "kaijofes-inventory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node --env-file=.env.local scripts/verify-live.mjs",
    "test:search-live": "node --experimental-strip-types --env-file=.env.local scripts/verify-search.mjs",
    "test:admin-live": "node --env-file=.env.local scripts/verify-admin-live.mjs",
    "test:photos-live": "node --env-file=.env.local scripts/verify-photos-live.mjs",
    "test:backup-live": "node --env-file=.env.local scripts/verify-backup-live.mjs",
    "restore:backup": "node --env-file=.env.local scripts/restore-backup.mjs",
    "check:client-secret": "node --env-file=.env.local scripts/check-client-secret.mjs",
    "test:restore-live": "node --env-file=.env.restore.local scripts/verify-restored-backup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
